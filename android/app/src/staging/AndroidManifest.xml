<?xml version="1.0" encoding="utf-8"?>
<!-- Staging build only: drop the HOME intent-filter so this package is never a Home app. Installing
     a second HOME app makes the Home button show Android's chooser until set-home-activity is re-run.
     LEANBACK_LAUNCHER stays, so it opens from the app list and by `am start`. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application>
        <activity android:name=".MainActivity">
            <intent-filter tools:node="remove">
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
    </application>
</manifest>
